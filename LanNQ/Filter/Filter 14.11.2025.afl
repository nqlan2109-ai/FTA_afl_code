_SECTION_BEGIN("Pivot high low");

procedure alternate_proc( pk, tr, sumpk, sumtr )
{
    global pkg;
    global trg;

    pkg = pk;
    trg = tr;
    idxpk = 0;
    idxtr = 0;
    flgtr = 0;
    flgpk = 0;

    for( i = 1; i < BarCount; i++ )
    {
        if( pk[i] AND sumpk[i] == 1 AND !tr[i] AND flgpk == 0 )
        {
            idxpk = i;
            flgtr = 0;
        }
        else
            if( ( pk[i] AND sumpk[i] > 1 AND !tr[i] ) OR( pk[i] AND flgpk == 1 ) )
            {
                if( H[i] > H[idxpk] )
                {
                    pkg[idxpk] = 0;
                    idxpk = i;
                    flgpk = 0;
                }
                else
                    if( H[i] <= H[idxpk] )
                    {
                        pkg[i] = 0;
                        flgpk = 0;
                    }
            }
            else
                if( tr[i] AND sumtr[i] == 1 AND !pk[i] AND flgtr == 0 )
                {
                    idxtr = i;
                    flgpk = 0;
                }
                else
                    if( ( tr[i] AND sumtr[i] > 1 AND !pk[i] ) OR( tr[i] AND flgtr == 1 ) )
                    {
                        if( L[i] < L[idxtr] )
                        {
                            trg[idxtr] = 0;
                            idxtr = i;
                            flgtr = 0;
                        }
                        else
                            if( L[i] >= L[idxtr] )
                            {
                                trg[i] = 0;
                                flgtr = 0;
                            }
                    }
                    else
                        if( pk[i] AND tr[i] )
                        {
                            if( sumpk[i - 1] > sumtr[i - 1] )
                            {
                                pkg[i] = 0;
                                flgtr = 1;
                                idxtr = i;
                            }
                            else
                                if( sumtr[i - 1] > sumpk[i - 1] )
                                {
                                    trg[i] = 0;
                                    flgpk = 1;
                                    idxpk = i;
                                }
                        }
    }
}

// Fractal Pivots
x = bi = BarIndex();
fvb = FirstVisibleValue( bi );
lvb = LastVisibleValue( bi );

rightstrength = Param( "Right Strength", 3, 2, 50, 1 );
leftstrength = Param( "Left Strength", 3, 2, 50, 1 );
leftstrength = rightstrength;

pk = C == HHV( C, leftstrength ) AND Ref( HHV( C, rightstrength ), rightstrength ) < C;
tr = C == LLV( C, leftstrength ) AND Ref( LLV( C, rightstrength ), rightstrength ) > C;

sumpk = Sum( pk, BarsSince( tr ) );
sumtr = Sum( tr, BarsSince( pk ) );
alternate_proc( pk, tr, sumpk, sumtr );
pk = pkg;
tr = trg;

for( i = 0; i < 5; i++ )
{
    VarSet( "px" + i, ValueWhen( pk, bi, i ) );
    VarSet( "tx" + i, ValueWhen( tr, bi, i ) );
    VarSet( "ph" + i, ValueWhen( pk, H, i ) );
    VarSet( "tl" + i, ValueWhen( tr, L, i ) );
}

ll = tr AND tl1 < tl2; // lower low	
hl = tr AND tl1 > tl2; // higher low
hh = pk AND ph1 > ph2; // higher high
lh = pk AND ph1 < ph2; // lower high
dt = pk AND ph1 == ph2;// double top
db = tr AND tl1 == tl2;// double bottom
VCP1 = ((ph4 - tl4 > ph3 - tl3 AND ph3 - tl3 > ph2 - tl2 AND ph2 - tl2 > ph1 - tl1) AND (ph4 > ph3 AND ph4 > ph2 AND ph4 > ph1) AND (tl4 < tl3 AND tl4 <tl2 AND tl4 < tl1)) AND LinRegSlope(MA(V, 50), px1 - px4) < 0;
VCP2 = ((ph3 - tl3 > ph2 - tl2 AND ph2 - tl2 > ph1 - tl1) AND (ph3 > ph2 AND ph3 > ph1) AND (tl3 < tl2 AND tl3 < tl1)) AND LinRegSlope(MA(V, 50), px1 - px3) < 0; 
VCP3 = ((ph2 - tl2 > ph1 - tl1) AND ph2 > ph1 AND tl2 < tl1);

clrpk = colorblack;
clrtr = colorblack;

for( i = lvb; i > fvb; i-- )
{
    // troughs
    if( ll[i] )
    {
        str = "" + WriteVal(L[i],8.2);
        PlotTextSetFont( str, "Arial", 8, i, L[i], clrtr, colorDefault, -30 );
    }

    if( hl[i] )
    {
        str = "" + WriteVal(L[i],8.2);
        PlotTextSetFont( str, "Arial", 8, i, L[i], clrtr, colorDefault, -30 );
    }

    if( db[i] )
    {
        str = "DB";
        PlotTextSetFont( str, "Arial", 8, i, L[i], clrtr, colorDefault, -30 );
    }

    //peaks
    if( hh[i] )
    {
        str = ""+WriteVal(H[i],8.2);
        PlotTextSetFont( str, "Arial", 8, i, H[i], clrpk, colorDefault, 20 );
    }

    if( lh[i] )
    {
        str = "" +WriteVal(H[i],8.2);
        PlotTextSetFont( str, "Arial", 8, i, H[i], clrpk, colorDefault, 20 );
    }

    if( dt[i] )
    {
        str = "DT";
        PlotTextSetFont( str, "Arial", 8, i, H[i], clrpk, colorDefault, 20 );
    }
}

GraphXSpace = 8;
Plot( Close,"Price",colorBlack,styleCandle);

//Tieu chi 3
MA20Volume = MA(Volume, 20); // Vol MA20
HighVolume = Volume > 1.2 * MA20Volume;

Bullish = C > O;
AccumulationCandle = Bullish AND HighVolume;

Bearish = C < O;
DistributionCandle = Bearish AND HighVolume;
// Tiêu chí 2: Volume phiên tang > Volume phiên tru?c (trong 10 phiên g?n nh?t)
upDay = Close > Ref(Close, -1);  // Phiên tang di?m
volIncreaseOnUp = Volume > Ref(Volume, -1);  // Volume tang
hasGoodVolume = Sum(upDay AND volIncreaseOnUp, 10) > 0;  // Có ít nh?t 1 phiên trong 10 ngày

Buy = (VCP1 OR VCP2 OR VCP3) AND Cross(C,ph1);
Sell = (VCP1 OR VCP2 OR VCP3) AND Cross(C,tl1);

Filter = tl1 > tl2 AND hasGoodVolume AND MA(V, 10) > 1000000 AND C > tl1 AND C<ph1;

AddColumn(MA(V, 10),"Vol MA10",1.2);
AddColumn(C,"Close",1.2);
AddColumn(tl2,"Trough 1",1.2);
AddColumn(tl1,"Trough 2",1.2);
AddColumn(tl1/tl2 - 1,"Khoang cach Day",1.2);