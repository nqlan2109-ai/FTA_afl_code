// ====================================================================
//  BOLLINGER BAND MEAN REVERSION SYSTEM
//  Dua theo chien luoc cua Larry Connors
// --------------------------------------------------------------------
//  Tham so Bollinger Band : SMA(5), Do lech chuan = 1
//  Historical Volatility  : x_i = ln(P_i / P_{i-1}), HV = StdDev(x,100) * sqrt(252)
//  %b                     : (Close - Lower) / (Upper - Lower)
// ====================================================================
fntsize = 8;// font size
dist = 75;// y-offset
bi = Barindex();
fvb = FirstVisiblevalue( bi );
lvb = LastVisiblevalue( bi );
dt = DateTime();
dtformat = "\n%Y-%m-%d";
bkcolor = -1;// text background color, -1 means default color (transparent)
// ====================================================================
//  PHAN 1: TINH TOAN CAC CHI SO KY THUAT
// ====================================================================

// --- 1.1 BOLLINGER BAND & %b ---
BB_Period = 5;
BB_Mid    = MA( C, BB_Period );
BB_Upper  = BBandTop( C, BB_Period, 1 );
BB_Lower  = BBandBot( C, BB_Period, 1 );
BB_Width  = BB_Upper - BB_Lower;
percentB  = ( C - BB_Lower ) / BB_Width;

// --- 1.2 HISTORICAL VOLATILITY 100 PHIEN ---
LogReturn = ln( C / Ref( C, -1 ) );
HV_100    = StDev( LogReturn, 100 ) * Sqrt( 252 );     // Rule 3

// --- 1.3 ADX 10 PHIEN ---
ADX_val = ADX( 10 );    // Rule 4

// --- 1.4 MOVING AVERAGES ---
MA_200 = MA( C, 200 );    // Rule 5
MA_5   = MA( C, 5 );      // Exit Mode 6
MA_3   = MA( C, 3 );      // Exit Mode 7

// --- 1.5 VOLUME TRUNG BINH 21 PHIEN ---
AvgVol21 = MA( V, 21 );

// --- 1.6 RSI 2 PHIEN ---
RSI2 = RSI( 2 );

// ====================================================================
//  PHAN 2: DIEU KIEN VAO LENH (ENTRY RULES 1-6)
// ====================================================================

// Rule 1: Gia co phieu > $10
Cond1_Price = C > 10;

// Rule 2: Volume trung binh 21 phien >= 250,000
Cond2_Volume = AvgVol21 >= 200000;

// Rule 3: HV 100 phien > 30% (Goc la 30%)
Cond3_HV = HV_100 > 0.3;

// Rule 4: ADX 10 phien > 30 (Goc la 30)
Cond4_ADX = ADX_val > 30;

// Rule 5: Gia dong cua tren MA 200 phien
Cond5_Trend = C > MA_200;

// Rule 6: %b roi vao vung < 0.1 se bat dau dem. Toi thieu phai co 2 phien lien tiep roi vao vung nay
Cond6_percentB  = 0;
Current_Zone    = 0;
Current_Count   = 0;
Array_Current_Zone  = 0;
Array_Current_Count = 0;
required_days_under = Param("Days under ( Y )", 4, 2, 4, 1);

for( i = 0; i < BarCount; i++ )
{
    pB = percentB[i];
    if     ( pB >  0.0 AND pB <  0.1 )  zone = 0.1;
    else if( pB <= 0.0 AND pB > -0.1 )  zone = 0;
    else if( pB <= -0.1              )   zone = -0.1;
    else                                 zone = 1;  // %b >= 0.1 -> ngoai vung

    if( zone == 1 )
    {
        Current_Zone  = Null;
        Current_Count = 0;
    }
    else
    {
        if( zone != 1 )
        {
            Current_Zone  = zone;
            Current_Count ++;
        }
    }

    // So phien toi thieu yeu cau: tat ca cac vung deu can >= 2 phien
    Cond6_percentB[i]   = ( Current_Zone < 1 ) AND ( Current_Count >= required_days_under ) AND ( Current_Count <= 4 );
    Array_Current_Zone[i]  = Current_Zone;
    Array_Current_Count[i] = Current_Count;
}

// Tin hieu vao lenh: tat ca 6 dieu kien phai dong thoi thoa man
BuySignal = Cond1_Price
          AND Cond2_Volume
          AND Cond3_HV
          AND Cond4_ADX
          AND Cond5_Trend
          AND Cond6_percentB;


// ====================================================================
//  PHAN 3: RULE 7 - VAO POSITION BUY
// ====================================================================
Z_pct      = Param( "limit % below close ( Z )", 2, 0, 10, 2 );
Limit_Order_Price = Ref ( C , -1 ) * ( 1 - Z_pct / 100 );

// Khoi tao tin hieu Mua tho truoc khi cho vao vong lap kiem tra tr?ng thai
Buy_position      = Ref ( BuySignal , -1 ) ; // Gia co the khong khop neu ngay hom do khong co gia do
BuyPrice    = min( Limit_Order_Price , O ) ;

// ====================================================================
//  PHAN 4: RULE 8 - DIEU KIEN THOAT LENH THO TRO (RAW SELL)
// ====================================================================
Exit_Mode1 = percentB >= 1.0;
Exit_Mode2 = percentB >= 0.75;
Exit_Mode3 = percentB >= 0.50;
Exit_Mode4 = RSI2 > 70;
Exit_Mode5 = RSI2 > 50;
Exit_Mode6 = Close > MA_5;
Exit_Mode7 = Close > MA_3;

ExitMode = Param( "ExitMode", 1, 1, 7, 1 );

SellSignal = IIf( ExitMode == 1, Exit_Mode1,
             IIf( ExitMode == 2, Exit_Mode2,
             IIf( ExitMode == 3, Exit_Mode3,
             IIf( ExitMode == 4, Exit_Mode4,
             IIf( ExitMode == 5, Exit_Mode5,
             IIf( ExitMode == 6, Exit_Mode6,
                                 Exit_Mode7 ) ) ) ) ) );

SellPrice = Close;


// ====================================================================
//  PHAN 5: VONG LAP FOR - LUULAI T+2 VA KHU TIN HIEU TRUNG (STATE MACHINE)
// ====================================================================
Buy = 0;
Sell = 0;
hasPosition = 0;
buyBar = -1;

for( i = 0; i < BarCount; i++ )
{
    if( hasPosition == 0 )
    {
        if( Buy_position[i] )
        {
            Buy[i] = 1;
            hasPosition = 1;
            buyBar = i; // Ghi lai vi tri bar cua lenh Mua gan nhat
        }
    }
    else // dang gi? v? th? (hasPosition == 1)
    {
        // Kiem tra neu co tin hieu ban VA so phien ke tu l?nh mua gan nhat >= 2 (T+2)
        if( SellSignal[i] AND ( i - buyBar >= 2 ) )
        {
            Sell[i] = 1;
            hasPosition = 0; // Xoa trang thai vi the, cho doi lenh Buy tiep theo
        }
    }
}


// ====================================================================
//  PHAN 6: VE BIEU DO CHINH
// ====================================================================

// --- To mau vung Bollinger Band ---
PlotOHLC( BB_Upper, BB_Upper, BB_Lower, BB_Lower, "",
          ColorBlend( colorLightGrey, GetChartBkColor(), 0.8 ),
          styleNoLabel | styleCloud | styleNoRescale, Null, Null, Null, -1 );

// --- Ve cac duong BB va gia ---
Plot( BB_Upper, "", colorLightGrey, styleLine | styleNoLabel );
Plot( BB_Mid,   "", colorRed,       styleLine );
Plot( BB_Lower, "", colorLightGrey, styleLine | styleNoLabel );

// --- Mui ten Buy/Sell ---
PlotShapes( IIf( Buy,  shapeUpArrow,   shapeNone ), colorBrightGreen, 0, Low,  -30 );
PlotShapes( IIf( Sell, shapeDownArrow, shapeNone ), colorRed,         0, High, -30 );

// --- Plot BuyPrice / SellPrice
PlotTextSetFont( "", "ARIAL", fntsize, BarCount-1, 0, -1 );
for ( i = fvb; i <= lvb; i++ ) {
    if( Buy[i] || Sell[i] )	{
		varBuy = "\n@" + BuyPrice[i] + DateTimeFormat(dtformat, dt[i]);
		varSell = "\n@" + SellPrice[i] + DateTimeFormat(dtformat, dt[i]);
		if( Buy[i] )  PlotText( "Buy" + varBuy, i, L[i], colorGreen, bkcolor, -dist+3*fntsize );
		if( Sell[i] ) PlotText( "Sell" + varSell, i, H[i], colorRed, bkcolor, dist );
    }
}

// --- TITLE (GOC TREN BEN TRAI) ---
Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} | Open %g, Hi %g, Lo %g, Close %g (%.1f%%)\n", O, H, L, C, SelectedValue( ROC( C, 1 ) ) ) +
        EncodeColor(colorDarkBlue) + "------------------------------------------------------------\n" + 
        EncodeColor(colorBlack) + "THONG SO KIEM TRA (Selected Bar):\n" +
        "Current Zone: " + WriteVal(Array_Current_Zone, 1.2) + "   |   Current Count: " + WriteVal(Array_Current_Count, 1.0) + "\n" +
        "%b: " + WriteVal(percentB, 1.4) + "   |   HV100: " + WriteVal(HV_100, 1.4) + "   |   ADX10: " + WriteVal(ADX_val, 1.2) + "\n" +
        "C1 (Price>10): " + WriteVal(Cond1_Price, 1.0) +
        "   |   C2 (Vol>=250k): " + WriteVal(Cond2_Volume, 1.0) +
        "   |   C3 (HV100>30%): " + WriteVal(Cond3_HV, 1.0) + "\n" +
        "C4 (ADX10>30): " + WriteVal(Cond4_ADX, 1.0) +
        "   |   C5 (C>MA200): " + WriteVal(Cond5_Trend, 1.0) +
        "   |   C6 (Zone Days): " + WriteVal(Cond6_percentB, 1.0) + "\n" ;

Plot( MA_200,              "MA200",                 colorBlue, styleLine | styleThick| styleNoRescale );


// ====================================================================
//  PHAN 7: EXIT MODE TEXT
// ====================================================================
ExitModeText = "Close > SMA(3)";
if( ExitMode == 6 ) ExitModeText = "Close > SMA(5)";
if( ExitMode == 5 ) ExitModeText = "RSI(2) > 50";
if( ExitMode == 4 ) ExitModeText = "RSI(2) > 70";
if( ExitMode == 3 ) ExitModeText = "%b >= 0.50";
if( ExitMode == 2 ) ExitModeText = "%b >= 0.75";
if( ExitMode == 1 ) ExitModeText = "%b >= 1.0 (Upper Band)";


// ====================================================================
//  PHAN 8: EXPLORATION - HIEN THI TUNG DIEU KIEN
// ====================================================================

Filter = BuySignal; 

AddColumn( Close,              "Close",          1.2 );
AddColumn( AvgVol21,           "AvgVol21",       1.0 );
AddColumn( HV_100,             "HV100",          1.4 );
AddColumn( ADX_val,            "ADX10",          1.2 );
AddColumn( MA_200,             "MA200",          1.2 );
AddColumn( percentB,           "%b",             1.4 );
AddColumn( Array_Current_Count,"Days Under ( Y )",     1.0 );
AddColumn( Array_Current_Zone, "Current Zone ( X )",     1.1 );
AddColumn( Limit_Order_Price,  "LimitPrice ( Z )",     1.4 );
AddTextColumn( ExitModeText,   "Exit Mode"              );

// Ket qua tung dieu kien (1 = thoa man, 0 = khong thoa man)
AddColumn( Cond1_Price,        "C1:Price>10",    1.0 );
AddColumn( Cond2_Volume,       "C2:Vol250k",     1.0 );
AddColumn( Cond3_HV,           "C3:HV>20%",      1.0 );
AddColumn( Cond4_ADX,          "C4:ADX>20",      1.0 );
AddColumn( Cond5_Trend,        "C5:>MA200",      1.0 );
AddColumn( Cond6_percentB,     "C6:C<%b Y Days",   1.0 );

// ====================================================================
//  PHAN 9: STATISTICAL
// ====================================================================

// --- MARKET CYCLE ---
function Market_Cycle()
{
    Date_num_signal = DateNum();
    Cycle_result    = Null;
    Cycle_result    = Nz( IIf( ( Date_num_signal >= 1060101 AND Date_num_signal <= 1090327 ), 1, Cycle_result ) );
    Cycle_result    = Nz( IIf( ( Date_num_signal >  1090327 AND Date_num_signal <= 1121019 ), 2, Cycle_result ) );
    Cycle_result    = Nz( IIf( ( Date_num_signal >  1121019 AND Date_num_signal <= 1160520 ), 3, Cycle_result ) );
    Cycle_result    = Nz( IIf( ( Date_num_signal >  1160520 AND Date_num_signal <= 1191220 ), 4, Cycle_result ) );
    Cycle_result    = Nz( IIf( ( Date_num_signal >= 1191220 AND Date_num_signal <= 1230630 ), 5, Cycle_result ) );
    Cycle_result    = Nz( IIf( Date_num_signal > 1230630, 6, Cycle_result ) );
    return Cycle_result;
}

CycleNum = Market_Cycle();
AddColumn( CycleNum, "Cycle Num", 1.0 );


// ====================================================================
//  PHAN 10: PRICE CHART
// ====================================================================
_SECTION_BEGIN( "Price" );
SetChartOptions( 0, chartShowArrows | chartShowDates);
Plot( C, "Close", ParamColor( "Color", colorDefault ), styleNoTitle | ParamStyle( "Style" ) | GetPriceStyle() );
_SECTION_END();

// ====================================================================
//  EOF - BB Mean Reversion System
// ====================================================================